<?xml version="1.0" encoding="UTF-8"?>
<configuration scan="true" scanPeriod="30 seconds">

    <!-- Человекочитаемый вывод для локальной разработки/dev -->
    <springProfile name="!prod">
        <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%green(%date{dd/MM/yy HH:mm:ss.SSS}) [%X{traceId:-}:%X{spanId:-}] %highlight(%-5level) %magenta([%X{requestor:-anonymous}]) %green([%file:%line]) %cyan(: %msg%n)</pattern>
                <charset>UTF-8</charset>
            </encoder>
        </appender>
    </springProfile>

    <!-- JSON-вывод для prod: структурированные логи удобно парсить в ELK/Loki без regex по цветному тексту -->
    <springProfile name="prod">
        <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LogstashEncoder"/>
        </appender>
    </springProfile>

    <logger name="a.gleb.resume_app" level="INFO"/>

    <!-- Note: Добавлено для логирования запуска приложения -->
    <logger name="org.springframework.boot.StartupInfoLogger" level="INFO"/>
    <logger name="org.springframework.boot.SpringApplication" level="INFO"/>
    <logger name="org.springframework.boot.web.embedded.tomcat.TomcatWebServer" level="INFO"/>

    <!-- Note: Подавление шумных логов Kafka-клиента (дампы конфигов, ребалансы и т.п.) -->
    <logger name="org.apache.kafka" level="WARN"/>
    <logger name="org.springframework.kafka" level="WARN"/>
    <logger name="org.springframework.cloud.stream.binder.kafka" level="WARN"/>

    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>

</configuration>
