<?xml version="1.0" encoding="UTF-8"?>
<configuration scan="true" scanPeriod="30 seconds">

    <!-- Человекочитаемый вывод для локальной разработки/dev -->
    <springProfile name="!prod">
        <appender name="STDOUT_RAW" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%green(%date{dd/MM/yy HH:mm:ss.SSS}) [%X{traceId:-}:%X{spanId:-}] %highlight(%-5level) %magenta([%X{requestor:-anonymous}]) %green([%file:%line]) %cyan(: %msg%n)</pattern>
                <charset>UTF-8</charset>
            </encoder>
        </appender>
    </springProfile>

    <!--
        JSON-вывод для prod: структурированные логи удобно парсить в ELK/Loki без regex по
        цветному тексту. LogstashEncoder по умолчанию включает в вывод весь текущий MDC
        (traceId/spanId от OTel-моста, requestor и т.п.), явный whitelist не нужен.
    -->
    <springProfile name="prod">
        <appender name="STDOUT_RAW" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LogstashEncoder"/>
        </appender>
    </springProfile>

    <!--
        Gateway реактивный (WebFlux) — обычный MDC.put на старте спана не переживает прыжки
        между потоками в Reactor. OpenTelemetryAppender читает актуальный OTel Context прямо
        в момент записи каждой строки лога и переписывает traceId/spanId перед передачей в
        STDOUT_RAW, поэтому значения всегда корректны независимо от того, на каком потоке
        выполняется код в момент логирования. Ключи переопределены в traceId/spanId (camelCase),
        чтобы совпадать с паттерном %X{traceId}/%X{spanId}, используемым во всех остальных
        сервисах (по умолчанию в этой библиотеке ключи snake_case: trace_id/span_id).
    -->
    <appender name="STDOUT" class="io.opentelemetry.instrumentation.logback.mdc.v1_0.OpenTelemetryAppender">
        <traceIdKey>traceId</traceIdKey>
        <spanIdKey>spanId</spanIdKey>
        <appender-ref ref="STDOUT_RAW"/>
    </appender>

    <logger name="a.gleb.gateway" level="INFO"/>

    <!-- Note: Добавлено для логирования запуска приложения -->
    <logger name="org.springframework.boot.StartupInfoLogger" level="INFO"/>
    <logger name="org.springframework.boot.SpringApplication" level="INFO"/>
    <logger name="org.springframework.boot.web.embedded.tomcat.TomcatWebServer" level="INFO"/>

    <!-- Note: Подавление шумных логов Kafka-клиента (дампы конфигов, ребалансы и т.п.) -->
    <logger name="org.apache.kafka" level="WARN"/>
    <logger name="org.springframework.kafka" level="WARN"/>
    <logger name="org.springframework.cloud.stream.binder.kafka" level="WARN"/>

    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>

</configuration>
